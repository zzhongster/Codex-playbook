{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/product-reverse-engineering/trace-link.schema.json",
  "title": "类型化追踪链接记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "version_scope",
    "source_id",
    "target_id",
    "relation",
    "evidence_status",
    "evidence_references",
    "contexts",
    "owner",
    "validation_method",
    "last_updated"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "allOf": [
        {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
        },
        {
          "pattern": "^trace:"
        }
      ]
    },
    "version_scope": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/versionScope"
    },
    "source_id": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
    },
    "target_id": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
    },
    "relation": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/relationKind"
    },
    "evidence_status": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/claimStatus"
    },
    "evidence_references": {
      "allOf": [
        {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/evidenceReferences"
        },
        {
          "minItems": 1
        }
      ]
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_id",
          "description"
        ],
        "properties": {
          "context_id": {
            "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
          },
          "description": {
            "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "owner": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/owner"
    },
    "validation_method": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/validationMethod"
    },
    "last_updated": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/date"
    }
  }
}
