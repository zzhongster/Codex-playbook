{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/product-reverse-engineering/experiment.schema.json",
  "title": "不可变运行实验三产物集合",
  "description": "协议、结果和副作用处置是三个独立产物；字段与 experiment-record 模板的三个 YAML 产物对齐。",
  "$comment": "仓库验证器实现 x-experiment-artifacts-are-bound，检查每个独立产物的方法与证据双向闭合、协议绑定、上下文、独立复现、运行 ID、证据索引和目标主张闭合；实验如实记录清理失败，不在本 schema 推导 G5 判定。",
  "type": "object",
  "additionalProperties": false,
  "x-experiment-artifacts-are-bound": true,
  "required": [
    "schema_version",
    "record_id",
    "protocol",
    "result",
    "effects",
    "owner",
    "last_updated"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "allOf": [
        {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
        },
        {
          "pattern": "^experiment:"
        }
      ]
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "effects": {
      "$ref": "#/$defs/effects"
    },
    "owner": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/owner"
    },
    "last_updated": {
      "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/date"
    }
  },
  "$defs": {
    "artifactId": {
      "allOf": [
        {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
        },
        {
          "pattern": "^artifact:"
        }
      ]
    },
    "claimReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/claimId"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
      }
    },
    "protocolReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "protocol_content_hash"
      ],
      "properties": {
        "protocol_id": {
          "$ref": "#/$defs/artifactId"
        },
        "protocol_content_hash": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/sha256"
        }
      }
    },
    "methodDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "method_maturity"
      ],
      "properties": {
        "method_id": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/methodId"
        },
        "method_maturity": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/methodMaturity"
        }
      }
    },
    "evidenceMethodEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "method_id"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/evidenceId"
        },
        "method_id": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/methodId"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "authorization_reference"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "authorized",
            "not-authorized",
            "not-applicable"
          ]
        },
        "authorization_reference": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "record_id",
        "content_hash",
        "product_version",
        "scope_or_module",
        "status",
        "created_at",
        "evidence_references",
        "owner",
        "validation_method",
        "last_updated",
        "claim_references",
        "method_definitions",
        "evidence_method_entries",
        "authorization_record_id",
        "authorization_gate_record_id",
        "environment_identity",
        "pre_state_fingerprint",
        "fingerprints",
        "sentinel",
        "action_permissions",
        "operational_limits",
        "recovery",
        "target_claim_references",
        "protocol_frozen_at",
        "role_and_test_account",
        "inputs",
        "alternative_explanations",
        "variables",
        "wait_conditions",
        "tool_versions",
        "forbidden_side_effects",
        "reproduction_criteria",
        "protocol_steps",
        "expected_observations"
      ],
      "properties": {
        "artifact_type": {
          "const": "ART-P5-PROTOCOL"
        },
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "record_id": {
          "$ref": "#/$defs/artifactId"
        },
        "content_hash": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/sha256"
        },
        "product_version": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "scope_or_module": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
        },
        "status": {
          "const": "frozen"
        },
        "created_at": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/timestamp"
        },
        "evidence_references": {
          "allOf": [
            {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/evidenceReferences"
            },
            {
              "minItems": 1
            }
          ]
        },
        "owner": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/owner"
        },
        "validation_method": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "last_updated": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/date"
        },
        "claim_references": {
          "$ref": "#/$defs/claimReferences"
        },
        "method_definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/methodDefinition"
          }
        },
        "evidence_method_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceMethodEntry"
          }
        },
        "authorization_record_id": {
          "$ref": "#/$defs/artifactId"
        },
        "authorization_gate_record_id": {
          "$ref": "#/$defs/artifactId"
        },
        "environment_identity": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "pre_state_fingerprint": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "artifact",
            "clone"
          ],
          "properties": {
            "source": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            },
            "artifact": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            },
            "clone": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "sentinel": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "action_permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read",
            "write",
            "fault-injection",
            "egress",
            "cleanup"
          ],
          "properties": {
            "read": {
              "$ref": "#/$defs/permission"
            },
            "write": {
              "$ref": "#/$defs/permission"
            },
            "fault-injection": {
              "$ref": "#/$defs/permission"
            },
            "egress": {
              "$ref": "#/$defs/permission"
            },
            "cleanup": {
              "$ref": "#/$defs/permission"
            }
          }
        },
        "operational_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cost",
            "rate",
            "blast_radius"
          ],
          "properties": {
            "cost": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            },
            "rate": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            },
            "blast_radius": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recovery_point",
            "owner",
            "max_restore_time"
          ],
          "properties": {
            "recovery_point": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            },
            "owner": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/owner"
            },
            "max_restore_time": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "target_claim_references": {
          "$ref": "#/$defs/claimReferences"
        },
        "protocol_frozen_at": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/timestamp"
        },
        "role_and_test_account": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "test_account_id"
          ],
          "properties": {
            "role": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            },
            "test_account_id": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id",
              "value_or_fingerprint",
              "data_classification"
            ],
            "properties": {
              "input_id": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
              },
              "value_or_fingerprint": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "data_classification": {
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted",
                  "synthetic"
                ]
              }
            }
          }
        },
        "alternative_explanations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "explanation_id",
              "statement",
              "distinguishing_evidence_needed"
            ],
            "properties": {
              "explanation_id": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
              },
              "statement": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "distinguishing_evidence_needed": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "controlled_value",
              "uncontrolled_limit"
            ],
            "properties": {
              "name": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "controlled_value": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "uncontrolled_limit": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "wait_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition",
              "timeout",
              "on_timeout"
            ],
            "properties": {
              "condition": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "timeout": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "on_timeout": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "tool_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "version",
              "configuration_hash"
            ],
            "properties": {
              "tool": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "version": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "configuration_hash": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "forbidden_side_effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effect",
              "detection",
              "stop_response"
            ],
            "properties": {
              "effect": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "detection": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "stop_response": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "reproduction_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_runs",
            "independent_executor_required",
            "environment_equivalence_rule",
            "tolerance_rule"
          ],
          "properties": {
            "required_runs": {
              "type": "integer",
              "minimum": 2
            },
            "independent_executor_required": {
              "const": true
            },
            "environment_equivalence_rule": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            },
            "tolerance_rule": {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "protocol_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "action",
              "input",
              "observation_points",
              "stop_condition"
            ],
            "properties": {
              "step_id": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
              },
              "action": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "input": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "observation_points": {
                "allOf": [
                  {
                    "$ref": "#/$defs/nonEmptyStringArray"
                  },
                  {
                    "minItems": 1
                  }
                ]
              },
              "stop_condition": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "expected_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observation_id",
              "surface",
              "expected",
              "tolerance"
            ],
            "properties": {
              "observation_id": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
              },
              "surface": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "expected": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              },
              "tolerance": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        }
      }
    },
    "runResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "ended_at",
        "executor",
        "environment_identity",
        "random_seed",
        "sample_selection",
        "result",
        "actual_observations",
        "deviations",
        "evidence_references"
      ],
      "properties": {
        "run_id": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
        },
        "started_at": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/timestamp"
        },
        "ended_at": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/timestamp"
        },
        "executor": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "environment_identity": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "random_seed": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "sample_selection": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/nonEmptyString"
        },
        "result": {
          "enum": [
            "not-run",
            "passed",
            "failed",
            "mixed"
          ]
        },
        "actual_observations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "deviations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "evidence_references": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/evidenceReferences"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "actual_observations": {
                "minItems": 1
              },
              "evidence_references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "firstFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "run_id",
        "captured_at",
        "observation_surfaces",
        "correlation_ids",
        "evidence_references",
        "preserved_before_retry"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "run_id": {
          "oneOf": [
            {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "oneOf": [
            {
              "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_surfaces": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "correlation_ids": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "evidence_references": {
          "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/evidenceReferences"
        },
        "preserved_before_retry": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "present": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "run_id": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/stableId"
              },
              "captured_at": {
                "$ref": "https://schemas.example.invalid/product-reverse-engineering/definitions.schema.json#/$defs/timestamp"
              },
              "observation_surfaces": {
                "minItems": 1
              },
              "correlation_ids": {
                "minItems": 1
              },
              "evidence_references": {
                "minItems": 1
              },
              "preserved_before_retry": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "run_id": {
                "type": "null"
              },
              "captured_at": {
                "type": "null"
              },
              "observation_surfaces": {
                "maxItems": 0
              },
              "correlation_ids": {
                "maxItems": 0
              },
              "evidence_references": {
                "maxItems": 0
              },
              "preserved_before_retry": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "content_hash",
        "status",
        "created_at",
        "owner",
        "product_version",
        "scope_or_module",
        "evidence_references",
        "method_definitions",
        "evidence_method_entries",
        "protocol_reference",
        "run_results",
